# ==============================================================================
# ShopPilot AI — Environment Configuration
# ==============================================================================

# Server Port
PORT=5001

# PostgreSQL Database (Optional - built-in zero-config SQLite engine used automatically if not set)
USE_POSTGRES=false
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=shoppilot
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/shoppilot

# JWT Authentication Secret
JWT_SECRET=shoppilot_super_secret_jwt_key_2026

# Google Gemini LLM API (for natural language parsing & merchant assistance)
LLM_API_KEY=your_gemini_api_key_here

# Razorpay Sandbox Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_Shoppilot2026
RAZORPAY_KEY_SECRET=shoppilot_secret_test_key
RAZORPAY_WEBHOOK_SECRET=shoppilot_webhook_secret_2026

# Python FastAPI Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000
